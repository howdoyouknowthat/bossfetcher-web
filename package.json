{
  "name": "bossfetcher-web",
  "version": "0.1.0",
  "private": true,
  "description": "BossFetcher Web — 帮你刷 boss 官网 + Tampermonkey 本地版",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:site": "pnpm --filter @bossfetcher/site build",
    "build:userscript": "pnpm --filter @bossfetcher/userscript build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm typecheck && pnpm test && pnpm build && node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "jsdom": "^24.1.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
